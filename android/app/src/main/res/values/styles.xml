<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flipper-style palette: orange LCD on black. -->
    <color name="orange">#FF8200</color>
    <color name="orange_pressed">#C86400</color>
    <color name="orange_dim">#D9822B</color>
    <color name="dark">#2E1700</color>
    <color name="border">#7A3D00</color>
    <color name="hint">#8A4A10</color>
    <color name="black">#000000</color>
    <color name="icon_bg">#C45A36</color>

    <style name="AppTheme" parent="android:Theme.Material">
        <item name="android:colorPrimary">@color/orange</item>
        <item name="android:colorPrimaryDark">@color/orange</item>
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:colorControlNormal">@color/orange</item>
        <item name="android:colorControlActivated">@color/orange</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/orange</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:textColorPrimary">@color/orange</item>
        <item name="android:textColorSecondary">@color/orange_dim</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textColorLink">@color/orange</item>
        <item name="android:textColorHighlight">#66FF8200</item>
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:actionBarStyle">@style/ActionBar</item>
        <item name="android:actionBarTheme">@style/ActionBarOverlay</item>
        <item name="android:actionBarPopupTheme">@style/Popup</item>
        <item name="android:buttonStyle">@style/Button</item>
        <item name="android:editTextStyle">@style/EditText</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>

    <style name="ActionBar" parent="android:Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/orange</item>
        <item name="android:titleTextStyle">@style/ActionBarTitle</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ActionBarTitle" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/silkscreen_bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ActionBarOverlay" parent="android:ThemeOverlay.Material.Light">
        <item name="android:colorControlNormal">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>

    <style name="Popup" parent="android:ThemeOverlay.Material.Dark">
        <item name="android:colorBackground">@color/dark</item>
        <item name="android:textColorPrimary">@color/orange</item>
        <item name="android:fontFamily">@font/vt323</item>
    </style>

    <style name="Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_orange</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/silkscreen_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="EditText" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/edit_bg</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textSize">22sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:colorControlNormal">@color/orange</item>
        <item name="android:textColorPrimary">@color/orange</item>
        <item name="android:textColorSecondary">@color/orange_dim</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:editTextStyle">@style/EditText</item>
    </style>
</resources>
